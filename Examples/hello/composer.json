{
    "name": "phpide/hello",
    "description": "PHPIDE example project",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Hello\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hello\\Tests\\": "tests/"
        }
    }
}
